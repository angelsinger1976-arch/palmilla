# ============================================================================
#  PalmillaBot — Archivos excluidos del control de versiones
# ============================================================================

# --- Entorno virtual y dependencias ---
venv/
.venv/
env/
ENV/

# --- Configuración local (¡CONTIENE LA API KEY!) ---
config.json
.env
.env.local
*.env

# --- Caché de Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Salidas generadas por la aplicación ---
output/*
!output/.gitkeep

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Registros y temporales ---
*.log
*.tmp
*.bak
