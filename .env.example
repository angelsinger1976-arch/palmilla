# =============================================================================
#  PalmillaBot — Variables de entorno (ejemplo)
# =============================================================================
#  Copia este archivo a ".env" y rellena tus valores, O exporta las variables
#  en tu shell antes de ejecutar ./run.sh.
#
#  Nota: la forma más sencilla de configurar la IA es desde la interfaz web
#  (pestaña ⚙️ Configuración), que guarda la clave en config.json.
#  Estas variables tienen PRIORIDAD sobre config.json.
# =============================================================================

# --- Google Gemini (IA generativa) ---
# Obtén tu API key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo de Gemini a utilizar (por defecto: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Servidor (opcional) ---
# Puerto del servidor local (por defecto: 8000)
# PORT=8000
